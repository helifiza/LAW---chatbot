# Tạo key tại Google AI Studio rồi chỉ điền vào backend/.env.
# Không commit hoặc gửi file .env chứa key thật.

APP_NAME=SLaw RAG API
APP_VERSION=2.0.0
DEBUG=true
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

GEMINI_API_KEY=COPY_KEY_API_GEMINI_VAO_DAY
GEMINI_RETRY_COUNT=5
GEMINI_RETRY_DELAY_SECONDS=2
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
EMBEDDING_BATCH_SIZE=50
GENERATION_MAX_TOKENS=1000
GENERATION_TEMPERATURE=0.2

# Query rewriting bằng HyDE.
HYDE_ENABLED=true
HYDE_MAX_TOKENS=350
HYDE_TEMPERATURE=0.4

# Dense + BM25 -> RRF -> CrossEncoder.
RETRIEVAL_CANDIDATE_K=30
RERANK_CANDIDATE_K=30
RRF_K=60
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=auto
RERANK_BATCH_SIZE=8
RERANK_MAX_LENGTH=1024

SQLITE_PATH=data/slaw_gemini.db
CHROMA_PERSIST_DIR=data/chroma_gemini
CHROMA_COLLECTION_NAME=slaw_documents_gemini_embedding_001_768_v1
UPLOAD_TEMP_DIR=data/tmp

MAX_SESSION_DOCUMENTS=5
MAX_FILE_SIZE_MB=10
CHUNK_SIZE_CHARS=2500
CHUNK_OVERLAP_CHARS=250
DEFAULT_TOP_K=8
MAX_TOP_K=20
# Chỉ áp dụng cho nhánh dense trước RRF, không áp dụng lên điểm CrossEncoder.
MIN_SIMILARITY=0.20
HISTORY_MESSAGE_LIMIT=8
